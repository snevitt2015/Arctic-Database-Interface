# Copy to .env and fill in what you have. Blank = that feed is off.
DATABASE_URL=sqlite:///arctic.db

# Area the live feeds subscribe to (default: everything north of 60N)
AOI_SOUTH=60
AOI_NORTH=90
AOI_WEST=-180
AOI_EAST=180

AISSTREAM_API_KEY=
NORWAY_AIS_ENABLED=false
GFW_API_TOKEN=
MARINETRAFFIC_API_KEY=
COPERNICUS_USER=
COPERNICUS_PASSWORD=

# Detector thresholds
GAP_HOURS=6
CYCLE_MIN_GAP_MIN=45
CYCLE_WINDOW_HOURS=24
CYCLE_MIN_COUNT=3
MAX_SPEED_KN=30
SPEED_MISMATCH_KN=5
